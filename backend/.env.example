# Backend Environment Variables

# ======================
# Environment
# ======================
NODE_ENV=development  # development, test, production

# ======================
# Server Configuration
# ======================
PORT=7000
HOST=0.0.0.0

# ======================
# Session Configuration
# ======================
SESSION_SECRET=your-secret-key-change-this-in-production
SESSION_COOKIE_MAX_AGE=86400000  # 24 hours in milliseconds
ENABLE_HTTPS=false  # Set to true in production for secure cookies

# ======================
# Auth0 Configuration
# ======================
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=a-long-random-string-for-session-cookies
AUTH0_BASE_URL=http://localhost:7000
AUTH0_AUDIENCE=http://localhost:7000/api

# ======================
# Database Configuration
# ======================
# PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=handwriting_app
# DB_USER=postgres
# DB_PASSWORD=your-password
# DATABASE_URL=postgresql://user:password@localhost:5432/handwriting_app

# MongoDB
# MONGODB_URI=mongodb://localhost:27017/handwriting_app
# MONGODB_DB_NAME=handwriting_app

# ======================
# OpenCV Configuration
# ======================
USE_PYTHON_OPENCV=false  # Set to true for production character segmentation
PYTHON_EXECUTABLE=python3
# OPENCV_PYTHON_PATH=/usr/bin/python3

# ======================
# File Upload Configuration
# ======================
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=image/png,image/jpeg,application/pdf
UPLOAD_DIR=data/uploads

# ======================
# PDF Generation
# ======================
DEFAULT_PAPER_SIZE=Letter  # Letter or A4

# ======================
# Security
# ======================
BCRYPT_ROUNDS=10

# ======================
# CORS Configuration
# ======================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001  # Comma-separated list
ENABLE_CORS=true

# ======================
# Rate Limiting
# ======================
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
# Specific limits for sensitive endpoints
LOGIN_RATE_LIMIT_MAX=5  # Max login attempts
REGISTER_RATE_LIMIT_MAX=3  # Max registration attempts per window

# ======================
# Logging
# ======================
LOG_LEVEL=info  # error, warn, info, http, debug
LOG_DIR=logs
LOG_MAX_FILES=5  # Number of rotated log files to keep
LOG_MAX_SIZE=5242880  # 5MB per log file

# ======================
# Frontend Configuration
# ======================
FRONTEND_URL=http://localhost:3000

# ======================
# Cloud Storage (for production)
# ======================
# AWS S3
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=handwriting-uploads
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=handwriting-uploads

# Cloudflare R2
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_BUCKET_NAME=handwriting-uploads

# ======================
# Email Configuration (for future features)
# ======================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# FROM_EMAIL=noreply@handwriting-app.com
# FROM_NAME=Handwritten Notes

# ======================
# Monitoring & Analytics (optional)
# ======================
# SENTRY_DSN=your-sentry-dsn
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# ======================
# Feature Flags
# ======================
ENABLE_REGISTRATION=true
ENABLE_DRAWING=true
ENABLE_TEMPLATE_UPLOAD=true
MAINTENANCE_MODE=false
