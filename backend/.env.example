# Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=5000

# Session Configuration
SESSION_SECRET=your-secret-key-change-this-in-production

# Auth0 Configuration
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=a-long-random-string-for-session-cookies
AUTH0_BASE_URL=http://localhost:5000
AUTH0_AUDIENCE=http://localhost:5000/api

# Database (if using a real database instead of JSON)
# DATABASE_URL=postgresql://user:password@localhost:5432/handwriting_app
# MONGODB_URI=mongodb://localhost:27017/handwriting_app

# Storage (if using cloud storage)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# S3_BUCKET_NAME=handwriting-uploads

# OpenCV Configuration (optional)
# OPENCV_PYTHON_PATH=/usr/bin/python3

# CORS Configuration (if needed)
# CORS_ORIGIN=http://localhost:3000

# Logging
# LOG_LEVEL=info
