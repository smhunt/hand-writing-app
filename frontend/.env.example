# Frontend Environment Variables

# API Configuration
# When running locally without Docker, uncomment the line below
# REACT_APP_API_URL=http://localhost:5000/api

# When using Docker, the proxy in package.json handles API routing
# No need to set REACT_APP_API_URL

# Development Configuration
# Enable polling for hot reload in Docker environments
# CHOKIDAR_USEPOLLING=true

# Analytics (optional)
# REACT_APP_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Feature Flags (optional)
# REACT_APP_ENABLE_DRAWING=true
# REACT_APP_ENABLE_SCANNING=true

# Custom Branding (optional)
# REACT_APP_BRAND_NAME=Handwritten Note App
# REACT_APP_BRAND_COLOR=#61dafb
